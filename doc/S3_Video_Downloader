**systemd service file:**

```ini
[Unit]
Description=S3 Continuous Downloader
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/testing_download
ExecStart=/home/ubuntu/testing_download/continuous_downloader.sh --channel "401,701"
Restart=always
RestartSec=10
StandardOutput=append:/var/log/s3-downloader.log
StandardError=append:/var/log/s3-downloader-error.log

[Install]
WantedBy=multi-user.target
```

```bash
